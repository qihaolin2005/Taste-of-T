// Owner: P2 - Data & Integrations (see TEAM.md)
// After editing: `npm run db:push` (updates dev.db and regenerates the client).
//
// Conventions
// - SQLite has no scalar lists, so string arrays (tastes, tags) are stored as Json.
// - Times of day are Int minutes after local midnight (may exceed 1440 past midnight),
//   matching `Minutes` in src/types. Dates are "YYYY-MM-DD" strings in America/New_York.
// - Station and place ids are string ids from data/stations.json and the places client.
//   They are not foreign keys, because those live outside the DB.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------- users

/// A player. Signed in via email + password, or a guest (email null) who can sign up later
/// and keep their progress. The session is a signed httpOnly cookie (see src/lib/session.ts).
model User {
  id           String    @id @default(cuid())
  email        String?   @unique // lowercased; null = guest
  passwordHash String? // scrypt, see src/lib/password.ts
  googleSub    String?   @unique // Google account id ("sub" claim) for Sign in with Google
  displayName  String    @default("T Explorer")
  avatar       String? // emoji or short string
  /// Points balance (shown as "points" in the app). Only changed by awardPoints() in
  /// src/features/gamification/points.ts, together with a PointsEvent row.
  xp           Int       @default(0)
  /// Set when first-run onboarding (dietary restrictions) is done.
  onboardedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  preferences          UserPreferences?
  location             UserLocation?
  checkIns             CheckIn[]
  stamps               Stamp[]
  achievements         Achievement[]
  ratings              Rating[]
  wishlist             WishlistItem[]
  hostedRooms          Room[]                @relation("RoomHost")
  memberships          RoomMember[]
  plans                Plan[]
  swipes               Swipe[]
  rewardVisits         RewardVisit[]
  recommendationsShown RecommendationShown[]
  quests               Quest[]
  pointsEvents         PointsEvent[]
  rides                Ride[]
  trips                Trip[]
}

/// Defaults that prefill the Spin form and room join form.
model UserPreferences {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tastes              Json     @default("[]") // string[]: matched against place tags
  avoid               Json     @default("[]") // string[]: hard exclusions, e.g. "seafood"
  dietary             Json     @default("[]") // string[]: e.g. "vegetarian", "halal"
  defaultBudget       Int? // USD per person per night
  maxWalkMinutes      Int?
  homeStationId       String?
  usualStartStationId String?
  /// City the user lives in (e.g. "Boston"); the group recommender draws candidates from it.
  city                String?
  /// Opt-in: only when true do we store the user's last known location.
  shareLocation       Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

/// Last known location only (one row per user, overwritten). We do not keep a
/// movement history; the only location history is explicit check-ins.
model UserLocation {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat              Float
  lng              Float
  accuracyM        Float?
  nearestStationId String?
  recordedAt       DateTime @default(now())
}

// ---------------------------------------------------------- game layer

model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId String
  placeId   String?
  lat       Float?
  lng       Float?
  accuracyM Float?
  method    String // "gps" | "demo"
  verified  Boolean  @default(false) // GPS fix was within the check-in radius
  xpAwarded Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Stamp {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId String
  earnedAt  DateTime @default(now())

  @@id([userId, stationId])
}

model Achievement {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String // e.g. "last-train", "night-owl", "new-line"
  unlockedAt DateTime @default(now())

  @@id([userId, code])
}

// ------------------------------------------------------- rooms & plans

model Room {
  id         String       @id // 4-letter join code, e.g. "BHSG" (see src/features/rooms/code.ts)
  name       String
  hostUserId String?
  host       User?        @relation("RoomHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  date       String // YYYY-MM-DD
  startTime  Int // Minutes
  slots      Json // StopCategory[]
  /// "collecting" (members joining) -> "swiping" (host started the adventure) -> "planned" (top 5 picked)
  status     String       @default("collecting")
  /// After this the room is gone and its code can be reused. Always set by createRoom().
  expiresAt  DateTime     @default(now())
  /// Squad session: the shortlist everyone swipes on (SessionDeck from src/features/ml/session.ts).
  deck       Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  members    RoomMember[]
  plans      Plan[]
  swipes     Swipe[]
  trips      Trip[]
}

/// A room member's inputs for one night (copied from preferences at join time, then editable).
model RoomMember {
  id             String   @id @default(cuid())
  roomId         String
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  startStationId String
  homeStationId  String
  budget         Int
  tastes         Json     @default("[]")
  avoid          Json     @default("[]")
  dietary        Json     @default("[]") // string[]: e.g. "vegetarian"; hard constraint
  leaveBy        Int? // Minutes
  maxWalkMinutes Int?
  city           String? // copied from preferences at join time
  joinedAt       DateTime @default(now())
  swipes         Swipe[]

  @@unique([roomId, userId])
  @@index([roomId])
}

/// A generated plan. Group plans have roomId; solo quests have userId only.
model Plan {
  id        String   @id @default(cuid())
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  request   Json // PlanRequest
  result    Json // Plan (or Quest for solo)
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

// ------------------------------------------------------------- swipes

/// One right (like) / left (dislike) swipe on a place. Solo swipes have no room; squad
/// swipes have roomId + memberId. Every swipe is also the user's taste history, so group
/// sessions improve individual recommendations (and later collaborative filtering).
model Swipe {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId    String?
  /// SetNull, not Cascade: expired rooms are deleted when their code is reused, and the swipes are
  /// still the user's taste history.
  room      Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  memberId  String?
  /// SetNull, not Cascade: if a member leaves the room, their swipes stay in their taste history.
  member    RoomMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  placeId   String // places-client id (not a FK, like Rating.placeId)
  liked     Boolean
  source    String // "solo" | "group"
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  /// One vote per person per place per session; swiping again (even after leaving and rejoining) updates it.
  @@unique([roomId, userId, placeId])
  @@index([userId, updatedAt])
}

// ------------------------------------------------------------ rewards

/// One rewarded restaurant visit (a verified receipt at a place we recommended). Points are
/// added to User.xp. Rules and numbers: src/features/rewards/config.ts.
model RewardVisit {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId         String
  /// For the points history ("Lantern Dumpling House"); null if the place couldn't be looked up.
  placeName       String?
  /// Set when the place came from this squad's top 5; squad-mates eating there raise the group bonus.
  roomId          String?
  /// "YYYY-MM-DD" in Boston: limits are per day.
  day             String
  /// Receipt facts only; the photo is never stored.
  receiptTotal    Float
  dinersOnReceipt Int
  receiptDate     String
  /// Same receipt can be claimed by at most `dinersOnReceipt` different people.
  receiptKey      String
  /// "bus" | "t" | "none": only a ride verified against live MBTA data counts (see Ride).
  travelMode      String
  /// The verified ride that earned the travel points. Unique: one ride pays out for one visit.
  rideId          String?       @unique
  ride            Ride?         @relation(fields: [rideId], references: [id], onDelete: SetNull)
  /// Points before the group multiplier, and what has actually been added to User.xp so far
  /// (it grows when more squad-mates check in at the same place).
  basePoints      Int
  groupMultiplier Float         @default(1)
  pointsAwarded   Int
  breakdown       Json
  createdAt       DateTime      @default(now())
  /// The points history rows for this visit: the visit itself, then any group-bonus top-ups.
  pointsEvents    PointsEvent[]

  @@unique([receiptKey, userId])
  @@index([userId, createdAt])
  @@index([userId, placeId])
  @@index([roomId, placeId, day])
}

/// Places shown to a user in their "for you" list (latest time only). A visit only earns points
/// if the place was recommended recently: shown here, or in one of their squads' top 5.
model RecommendationShown {
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId String
  shownAt DateTime @default(now())

  @@id([userId, placeId])
}

// ---------------------------------------------------- ratings & wishlist

model Rating {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String
  score     Float // 0-10
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, placeId])
}

model WishlistItem {
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId String
  addedAt DateTime @default(now())

  @@id([userId, placeId])
}

// ------------------------------------------------------------- points

/// A solo food quest ("Spin the T"). Its point value is fixed by the server when the quest
/// is created, so completing it can't be gamed by the client.
model Quest {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  stationId   String?
  /// Spin the T: the place this quest sends you to (null for other quests).
  placeId     String?
  placeName   String?
  placeLat    Float?
  placeLng    Float?
  /// Points awarded on completion. TODO(ML): set by the points model; today a fixed default.
  points      Int
  status      String       @default("active") // "active" | "completed" | "abandoned"
  createdAt   DateTime     @default(now())
  completedAt DateTime?
  award       PointsEvent?

  @@index([userId, status])
}

/// Append-only log of every points change. User.xp is the running total of these.
/// One event per quest at most (questId is unique), so a quest can never pay out twice.
model PointsEvent {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int
  reason        String // "quest_completed" | "restaurant_visit" | "group_bonus" (more later: check-ins, achievements...)
  questId       String?      @unique
  quest         Quest?       @relation(fields: [questId], references: [id], onDelete: SetNull)
  /// For "restaurant_visit" and "group_bonus": the visit (src/features/rewards). Several rows per visit.
  rewardVisitId String?
  rewardVisit   RewardVisit? @relation(fields: [rewardVisitId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([rewardVisitId])
}

// ------------------------------------------------------------- rides

/// A bus/T ride, verified against live MBTA vehicle positions (src/features/rides).
/// The phone sends a location ping every ~30 s while riding; a ping "matches" when a live MBTA
/// vehicle is right there. Verified = 2+ matches on the SAME vehicle, 60+ s and 300+ m apart,
/// faster than walking. Raw pings are never stored: only the first and last matched positions,
/// rounded to ~11 m.
model Ride {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "tracking" (collecting pings) | "verified"
  status       String       @default("tracking")
  /// "bus" | "t" (subway, light rail, commuter rail)
  mode         String?
  routeId      String?
  routeName    String?
  vehicleId    String?
  /// Vehicles near your pings and how often each matched ({ [vehicleId]: {...} }). The one you're
  /// really on keeps matching; it becomes vehicleId. See src/features/rides/service.ts.
  candidates   Json?
  matchedPings Int          @default(0)
  firstMatchAt DateTime?
  lastMatchAt  DateTime?
  startLat     Float?
  startLng     Float?
  endLat       Float?
  endLng       Float?
  /// Straight-line meters between the first and last match.
  distanceM    Float        @default(0)
  lastPingAt   DateTime     @default(now())
  verifiedAt   DateTime?
  createdAt    DateTime     @default(now())
  rewardVisit  RewardVisit?

  @@index([userId, createdAt])
}

/// A recorded trip (Strava-style): the path someone took to a restaurant, solo or with a group.
/// Recorded only after the user taps "Start trip". See src/features/trips.
model Trip {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Group trip: room members can see it while the room exists. Null = only you can see it.
  roomId      String?
  room        Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  /// "recording" | "finished"
  status      String    @default("recording")
  /// Destination (optional for solo trips). Arriving within ~60 m finishes the trip.
  placeId     String?
  placeName   String?
  placeLat    Float?
  placeLng    Float?
  /// [lat, lng, secondsSinceStart][] (cleaned: no jitter, glitches, or low-accuracy fixes).
  points      Json      @default("[]")
  distanceM   Float     @default(0)
  startedAt   DateTime  @default(now())
  lastPointAt DateTime?
  endedAt     DateTime?
  /// true when it finished because you reached the destination.
  arrived     Boolean   @default(false)
  /// Spin the T quest this trip is for: arriving completes it (and pays its points).
  questId     String?
  createdAt   DateTime  @default(now())

  @@index([userId, startedAt])
  @@index([roomId])
}
