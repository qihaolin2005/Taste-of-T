# Copy to .env  (cp .env.example .env)
# The app must work with MBTA_API_KEY and PLACES_API_KEY empty (offline seed mode).
MBTA_API_KEY=

# Google Places API (New) for real restaurants (optional: without it, demo places are used).
# SERVER-ONLY key restricted to "Places API (New)". Not the browser Maps key. See src/lib/places/README.md
PLACES_API_KEY=
# Minutes to keep Google results in memory (fewer paid calls). Never written to disk.
PLACES_CACHE_TTL_MIN=60
PLACES_TIMEOUT_MS=5000

# Which map to draw: "offline" (default, the built-in SVG map, no Google quota used) or
# "google" (Google Maps; also needs NEXT_PUBLIC_GOOGLE_MAPS_API_KEY). Restart dev after changing.
NEXT_PUBLIC_MAP=offline

# Google Maps for the T map (only used with NEXT_PUBLIC_MAP=google).
# This key is sent to browsers, so restrict it to your domains (HTTP referrers) and to the
# "Maps JavaScript API" in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for advanced markers + dark mode. Leave empty to use Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Sign in with Google (optional: without it the Google button is hidden).
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application.
# Add every origin you open the app from under "Authorized JavaScript origins"
# (e.g. http://localhost:3000 and your deployed https:// domain). Not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Local SQLite file. For a hosted deploy, use Turso: DATABASE_URL=libsql://<db>.turso.io
DATABASE_URL="file:./prisma/dev.db"
TURSO_AUTH_TOKEN=

# Recommendation model (optional). Without it, the built-in baseline scorer is used.
# Contract: src/features/ml/README.md
ML_MODEL_URL=
ML_MODEL_TIMEOUT_MS=1500
ML_MODEL_TOKEN=
# Salt for pseudonymous ids sent to the model (defaults to SESSION_SECRET).
ML_SUBJECT_SALT=

# Signs the session cookie. Required in production; any long random string.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Receipt scanning for reward claims (optional, SECRET, server-only). Gemini reads the receipt photo.
# Free key: https://aistudio.google.com/apikey
# Without it, receipts are typed in and only the GPS check-in proves the visit. See docs/rewards.md
GEMINI_API_KEY=

# Live T + bus directions on the T map (optional, SECRET, server-only). A Google Cloud key with the
# "Routes API" enabled. Without it, the map plans subway-only routes offline from the MBTA data,
# and "Open in Google Maps" still gives full bus + T directions. See src/features/directions.
ROUTES_API_KEY=
