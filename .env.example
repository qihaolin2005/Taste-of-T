# Copy to .env  (cp .env.example .env)
# The app must work with MBTA_API_KEY and PLACES_API_KEY empty (offline seed mode).
MBTA_API_KEY=
PLACES_API_KEY=

# Google Maps for the T map (optional: without it the app shows the offline SVG map).
# This key is sent to browsers, so restrict it to your domains (HTTP referrers) and to the
# "Maps JavaScript API" in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for advanced markers + dark mode. Leave empty to use Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Sign in with Google (optional: without it the Google button is hidden).
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application.
# Add every origin you open the app from under "Authorized JavaScript origins"
# (e.g. http://localhost:3000 and your deployed https:// domain). Not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Local SQLite file. For a hosted deploy, use Turso: DATABASE_URL=libsql://<db>.turso.io
DATABASE_URL="file:./prisma/dev.db"
TURSO_AUTH_TOKEN=

# Recommendation model (optional). Without it, the built-in baseline scorer is used.
# Contract: src/features/ml/README.md
ML_MODEL_URL=
ML_MODEL_TIMEOUT_MS=1500
ML_MODEL_TOKEN=
# Salt for pseudonymous ids sent to the model (defaults to SESSION_SECRET).
ML_SUBJECT_SALT=

# Signs the session cookie. Required in production; any long random string.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
